# Copy this file to .env and fill in values. Never commit .env.

# LLM
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: Groq / Ollama / Azure-compatible endpoints
# LLM_PROVIDER=groq
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=gsk_...

# Job search (optional; leave empty to use mock listings)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# App
LOG_LEVEL=INFO
USE_MOCK_JOBS=true
USE_LLM=false
